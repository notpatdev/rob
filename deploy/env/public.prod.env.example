APP_ENV=prod
LOG_LEVEL=INFO

# Public API runtime DB user: SELECT-only role, NEVER the webhook writer role.
# See db/grants/prod_rob_public.sql.
DATABASE_URL=postgresql://prod_rob_public:<password>@<db-host>:25060/rob_prod?sslmode=require

# Public read-only API server. Do not add DISCORD_TOKEN on this host.
PUBLIC_API_HOST=127.0.0.1
PUBLIC_API_PORT=8090

# Browser origin allowed to call the API. Use https://robthebot.com in prod;
# set to * only while testing.
PUBLIC_API_ALLOWED_ORIGIN=https://robthebot.com
