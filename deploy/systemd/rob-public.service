[Unit]
Description=Rob Public API Service
After=network.target

[Service]
Type=simple
User=rob
Group=rob
WorkingDirectory=/opt/rob-public/app
EnvironmentFile=/opt/rob-public/app/.env
Environment=PYTHONPATH=/opt/rob-public/app
ExecStart=/opt/rob-public/app/.venv/bin/python -m apps.public.main
Restart=always
RestartSec=5

# --- sandboxing / hardening ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
