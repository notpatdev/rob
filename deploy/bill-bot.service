[Unit]
Description=Bill Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bill
Group=bill
WorkingDirectory=/opt/bill
EnvironmentFile=/etc/bill/bill-bot.env
ExecStart=/opt/bill/.venv/bin/bill-bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
